#!/usr/bin/env python3
"""Root-only control; credentials never printed or placed in curl arguments."""
import json,sys,urllib.request
from pathlib import Path
if len(sys.argv)!=2 or sys.argv[1] not in ['stop','start','status']:
 raise SystemExit('Usage: sudo native-cape-contest stop|start|status')
env=dict(line.strip().split('=',1) for line in Path('/etc/native-cape-contest.env').read_text().splitlines() if '=' in line and not line.startswith('#'))
action=sys.argv[1];data=None if action=='status' else json.dumps({'action':'close' if action=='stop' else 'open'}).encode()
r=urllib.request.Request('http://127.0.0.1:3426/api/bot/event',data=data,headers={'Authorization':'Bearer '+env['BOT_API_KEY'],'Content-Type':'application/json'})
with urllib.request.urlopen(r,timeout=15) as res:result=json.load(res)
print('Contest OPEN' if result['open'] else 'Contest CLOSED')
if action=='stop':print('Submissions stopped. Existing bot must collect and submit the final human-only reaction snapshot; this command does not fetch Discord votes.')
